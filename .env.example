# Copy this file to .env and fill in real values. Never commit .env to version control.

# SQLite database file path (relative to project root)
DATABASE_URL=./proximity_match.db

# Secret salt used when hashing stored API keys (change before any deployment)
API_KEY_SALT=REPLACE_WITH_RANDOM_32_CHAR_STRING

# Matching engine weights (floats)
INTEREST_WEIGHT=10.0
DISTANCE_WEIGHT=1.0

# Default search radius in kilometres
DEFAULT_RADIUS_KM=0.5

# Maximum number of matches returned per query
MAX_MATCHES_RETURNED=20

# Cache TTL in seconds for match query results
MATCH_CACHE_TTL_SECONDS=30

# Rate limiter: max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Allowed CORS origins (comma-separated). Restrict in production.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
